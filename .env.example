# ============================================================
# Vin's Sidekick - environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Telegram (required) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAAA-fake-placeholder-token

# --- OpenAI (required) ---
# Set a spend cap on this key from the OpenAI dashboard - that is the real backstop.
OPENAI_API_KEY=sk-fake-placeholder-key

# --- Model routing (defaults per Planning.md Phase 1; gpt-4o line retired) ---
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_ANALYSIS=gpt-5.6-sol
# Only invoked on the rare voice-fallback "full metrics" branch (deprecated Aug 2026, shutdown Feb 2027)
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Provider (openai-only for MVP; Anthropic is a future additive seam) ---
LLM_PROVIDER=openai
# Optional, unused for MVP
ANTHROPIC_API_KEY=

# --- Access control (required) ---
# Shared passcode on /start. Anyone with the bot link/username + this passcode gets access.
DEMO_PASSCODE=change-me

# --- Runtime (optional; defaults shown) ---
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO
DAILY_TICK_HOUR=9
